{
  "name": "auth-demo",
  "private": true,
  "description": "The Forger: a tiny auth server (bcrypt, sessions, hand-written HS256 JWT, RBAC) for the auth talk",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts start",
    "stop": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts stop",
    "status": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts status",
    "users": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts users",
    "dev": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/server.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "tsc --noEmit",
    "jwt": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts login"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3"
  }
}
